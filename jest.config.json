{
  "preset": "@vue/cli-plugin-unit-jest/presets/typescript-and-babel",
  "setupFiles": ["<rootDir>/tests/jest/require-context.setup.js"],
  "globals": {
    "ts-jest": {
      "tsconfig": {
        "importHelpers": false
      }
    }
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(\\.pnpm/|@ionic/(vue|vue-router|core)|@stencil/core|ionicons|three/))"
  ],
  "transform": {
    "/three/build/three\\.(module|core)\\.js$": "<rootDir>/tests/jest/esm-transform.js"
  }
}
