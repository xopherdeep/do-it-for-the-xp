<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Bevel: dark rim -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#101018" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- Mid Bevel: white frame -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#f0f0f8" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <!-- Inner Bevel: grey accent -->
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#8888b0" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <!-- Final Fantasy Classic SNES Gradient Fill -->
    <item
        android:bottom="5dp"
        android:left="5dp"
        android:right="5dp"
        android:top="5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#0a0a52"
                android:startColor="#6262d8" />
            <corners android:radius="5dp" />
        </shape>
    </item>
</layer-list>
