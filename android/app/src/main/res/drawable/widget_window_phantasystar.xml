        <shape android:shape="rectangle">
            <solid android:color="#001830" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#38c0e8" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#040c1c" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
