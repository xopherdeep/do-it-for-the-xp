<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pedestal Shadow / Bottom Lip -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#1A000000" />
        </shape>
    </item>

    <!-- Pedestal Body -->
    <item
        android:bottom="3dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#2D3748" />
            <stroke
                android:width="1.5dp"
                android:color="#4A5568" />
        </shape>
    </item>

    <!-- Pedestal Top Surface Inset -->
    <item
        android:bottom="5dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#1A202C" />
            <stroke
                android:width="1dp"
                android:color="#CBD5E0" />
        </shape>
    </item>
</layer-list>
