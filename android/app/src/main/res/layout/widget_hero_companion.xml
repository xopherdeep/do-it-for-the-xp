<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_window_earthbound"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_companion_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Hero"
            android:textColor="@color/widget_accent_earthbound"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_companion_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_bg"
            android:paddingLeft="6dp"
            android:paddingTop="1dp"
            android:paddingRight="6dp"
            android:paddingBottom="1dp"
            android:text="LV 1"
            android:textColor="@color/widget_text_primary"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_companion_class"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Novice Adventurer"
        android:textColor="@color/widget_text_muted"
        android:textSize="10sp" />

    <!-- Center Dialogue Bubble -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/widget_companion_quote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_bg"
            android:gravity="center"
            android:padding="8dp"
            android:text="&quot;Ready for adventure! Check the quest board!&quot;"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Footer Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_companion_streak"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="1-Day Streak"
            android:textColor="@color/widget_flame"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to visit"
            android:textColor="@color/widget_text_muted"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>
