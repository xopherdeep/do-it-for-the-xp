<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_window_earthbound"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PARTY VITALS"
            android:textColor="@color/widget_accent_earthbound"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_party_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_bg"
            android:paddingLeft="6dp"
            android:paddingTop="1dp"
            android:paddingRight="6dp"
            android:paddingBottom="1dp"
            android:text="PARTY"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="@color/widget_border_earthbound"
        android:importantForAccessibility="no" />

    <!-- Hero Slot 1 -->
    <LinearLayout
        android:id="@+id/party_slot_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/party_hero_1_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Hero 1"
            android:textColor="@color/widget_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/party_hero_1_lvl"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:text="LV 1"
            android:textColor="@color/widget_accent_earthbound"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/party_hero_1_hp"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="50dp"
            android:layout_height="6dp"
            android:layout_marginStart="4dp"
            android:max="100"
            android:progress="100"
            android:progressDrawable="@drawable/widget_progress_hp" />

        <ProgressBar
            android:id="@+id/party_hero_1_mp"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="35dp"
            android:layout_height="6dp"
            android:layout_marginStart="4dp"
            android:max="100"
            android:progress="100"
            android:progressDrawable="@drawable/widget_progress_mp" />
    </LinearLayout>

    <!-- Hero Slot 2 -->
    <LinearLayout
        android:id="@+id/party_slot_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/party_hero_2_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Hero 2"
            android:textColor="@color/widget_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/party_hero_2_lvl"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:text="LV 1"
            android:textColor="@color/widget_accent_earthbound"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/party_hero_2_hp"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="50dp"
            android:layout_height="6dp"
            android:layout_marginStart="4dp"
            android:max="100"
            android:progress="80"
            android:progressDrawable="@drawable/widget_progress_hp" />

        <ProgressBar
            android:id="@+id/party_hero_2_mp"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="35dp"
            android:layout_height="6dp"
            android:layout_marginStart="4dp"
            android:max="100"
            android:progress="60"
            android:progressDrawable="@drawable/widget_progress_mp" />
    </LinearLayout>

    <!-- Hero Slot 3 -->
    <LinearLayout
        android:id="@+id/party_slot_3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/party_hero_3_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Hero 3"
            android:textColor="@color/widget_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/party_hero_3_lvl"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:text="LV 1"
            android:textColor="@color/widget_accent_earthbound"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/party_hero_3_hp"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="50dp"
            android:layout_height="6dp"
            android:layout_marginStart="4dp"
            android:max="100"
            android:progress="100"
            android:progressDrawable="@drawable/widget_progress_hp" />

        <ProgressBar
            android:id="@+id/party_hero_3_mp"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="35dp"
            android:layout_height="6dp"
            android:layout_marginStart="4dp"
            android:max="100"
            android:progress="100"
            android:progressDrawable="@drawable/widget_progress_mp" />
    </LinearLayout>

    <!-- Hero Slot 4 -->
    <LinearLayout
        android:id="@+id/party_slot_4"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/party_hero_4_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Hero 4"
            android:textColor="@color/widget_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/party_hero_4_lvl"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:text="LV 1"
            android:textColor="@color/widget_accent_earthbound"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/party_hero_4_hp"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="50dp"
            android:layout_height="6dp"
            android:layout_marginStart="4dp"
            android:max="100"
            android:progress="100"
            android:progressDrawable="@drawable/widget_progress_hp" />

        <ProgressBar
            android:id="@+id/party_hero_4_mp"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="35dp"
            android:layout_height="6dp"
            android:layout_marginStart="4dp"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@drawable/widget_progress_mp" />
    </LinearLayout>
</LinearLayout>
