# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
package-lock.json
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*

/.idea
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode
/coverage
/dist
/node_modules
/platforms
/plugins
/www
.aider*

src/assets/images/backgrounds/ai/*
src/assets/images/backgrounds/old/*
src/assets/images/backgrounds/gaia/*
.env
# Chemical X local telemetry & audit history
.chemx/

# Cypress run artifacts
cypress/
tests/e2e/screenshots/
tests/e2e/videos/

__pycache__/
*.pyc

# tools/art generators: review output (world_backgrounds.py)
tools/art/out/
tools/For the xp/
